# Public build-time config. Everything prefixed VITE_ is inlined into the bundle —
# never put secrets here.
#
# Empty in dev → requests go to relative "/api/v1" and the Vite dev server proxies
# them to http://localhost:4000 (no CORS).
# Production: absolute HTTPS origin of the API, e.g. https://api.example.com
# (the build refuses non-HTTPS origins other than localhost).
VITE_API_BASE_URL=
